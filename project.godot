; Engine configuration file.
; Godot 4.5+. Open this folder in the Godot project manager (Import -> select this file).

config_version=5

[application]

config/name="DREAM PROTOCOL"
config/description="First-person psychological horror about lucid dreaming."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Data="*res://scripts/autoload/data.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Notebook="*res://scripts/autoload/notebook.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"
Anomalies="*res://scripts/autoload/anomalies.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
