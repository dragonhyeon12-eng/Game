; Engine configuration file.
; Godot 4.7+. Open this folder in the Godot project manager (Import -> select this file).

config_version=5

[application]

config/name="DREAM PROTOCOL"
config/description="First-person psychological horror about lucid dreaming."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Loc="*res://scripts/autoload/loc.gd"
Data="*res://scripts/autoload/data.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Notebook="*res://scripts/autoload/notebook.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"
Anomalies="*res://scripts/autoload/anomalies.gd"
Journal="*res://scripts/autoload/journal.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/screen_space_aa.web=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=2048

[physics]

3d/physics_engine="Jolt Physics"
